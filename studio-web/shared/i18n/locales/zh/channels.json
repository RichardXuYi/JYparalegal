        "discord": {
            "description": "使用开发者门户的机器人令牌连接 Discord",
            "docsUrl": "https://icnnp7d0dymg.feishu.cn/wiki/BkOywJYCAiYRN9k4KTTceKPMnxg#QS6LdxnA2oNtfcxtFc8cgabnnNd",
            "fields": {
                "token": {
                    "label": "机器人令牌",
                    "placeholder": "您的 Discord 机器人令牌"
                },
                "guildId": {
                    "label": "服务器 ID",
                    "placeholder": "例如 123456789012345678",
                    "description": "将机器人限制在特定服务器。右键服务器 → 复制服务器 ID。"
                },
                "channelId": {
                    "label": "频道 ID（可选）",
                    "placeholder": "例如 123456789012345678",
                    "description": "将机器人限制在特定频道。右键频道 → 复制频道 ID。"
                }
            },
            "instructions": [
                "前往 Discord 开发者门户 → 应用 → 新建应用",
                "在机器人部分：添加机器人，然后复制机器人令牌",
                "在机器人 → 特权网关意图中启用消息内容意图 + 服务器成员意图",
                "在 OAuth2 → URL 生成器中：选择 \"bot\" + \"applications.commands\"，添加消息权限",
                "使用生成的 URL 将机器人邀请到您的服务器",
                "将机器人令牌粘贴到下方"
            ]
        },
