{
    "name": "jy-studio-web",
    "version": "1.5.0",
    "description": "GrandPoem Studio Web - Browser-based Studio powered by OpenClaw (Web port of GrandPoem Studio)",
    "author": "GrandPoem Team",
    "license": "UNLICENSED",
    "private": true,
    "type": "module",
    "scripts": {
        "postinstall": "node scripts/patch-browser-hint.mjs",
        "predev": "node scripts/generate-ext-bridge.mjs && zx scripts/prepare-preinstalled-skills-dev.mjs",
        "dev": "vite",
        "dev:server": "tsx watch --tsconfig server/tsconfig.json server/src/index.ts",
        "start:server": "tsx --tsconfig server/tsconfig.json server/src/index.ts",
        "ext:bridge": "node scripts/generate-ext-bridge.mjs",
        "prebuild": "node scripts/generate-ext-bridge.mjs",
        "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
        "build:analyze": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --mode analyze",
        "build:server": "tsc -p server/tsconfig.json",
        "preview": "vite preview",
        "lint": "eslint . --fix",
        "lint:check": "eslint . && node scripts/check-ui-conventions.mjs",
        "lint:ui": "node scripts/check-ui-conventions.mjs",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
        "typecheck": "pnpm run typecheck:web && pnpm run typecheck:server",
        "verify:manager-restart": "tsx --tsconfig server/tsconfig.json scripts/verify-manager-restart.ts"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.2",
        "@fastify/static": "^8.3.0",
        "@fastify/websocket": "^11.2.0",
        "@sinclair/typebox": "^0.34.48",
        "adm-zip": "^0.5.16",
        "chokidar": "^5.0.0",
        "fastify": "^5.7.4",
        "https-proxy-agent": "^9.0.0",
        "jsonwebtoken": "^9.0.2",
        "lru-cache": "^11.2.6",
        "ms": "^2.1.3",
        "node-machine-id": "^1.1.12",
        "openclaw": "2026.9.6",
        "posthog-node": "^4.18.0",
        "tar": "^6.2.1",
        "tsx": "^4.20.0",
        "undici": "8.1.0",
        "ws": "^8.19.0",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@eslint/js": "catalog:",
        "@monaco-editor/react": "^4.7.0",
        "@radix-ui/react-dialog": "catalog:",
        "@radix-ui/react-dropdown-menu": "catalog:",
        "@radix-ui/react-label": "catalog:",
        "@radix-ui/react-progress": "catalog:",
        "@radix-ui/react-radio-group": "catalog:",
        "@radix-ui/react-select": "catalog:",
        "@radix-ui/react-separator": "catalog:",
        "@radix-ui/react-slot": "catalog:",
        "@radix-ui/react-switch": "catalog:",
        "@radix-ui/react-tabs": "catalog:",
        "@radix-ui/react-toast": "catalog:",
        "@radix-ui/react-tooltip": "catalog:",
        "@tailwindcss/postcss": "^4.1.18",
        "@tailwindcss/vite": "catalog:",
        "@types/adm-zip": "^0.5.7",
        "@types/diff": "^8.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "catalog:",
        "@typescript-eslint/parser": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "autoprefixer": "^10.4.24",
        "class-variance-authority": "catalog:",
        "clsx": "catalog:",
        "diff": "^9.0.0",
        "eslint": "catalog:",
        "eslint-plugin-react-hooks": "catalog:",
        "eslint-plugin-react-refresh": "catalog:",
        "globals": "catalog:",
        "i18next": "^25.8.11",
        "katex": "^0.16.45",
        "lucide-react": "catalog:",
        "monaco-editor": "^0.55.1",
        "motion": "catalog:",
        "postcss": "^8.5.6",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-i18next": "^16.5.4",
        "react-markdown": "catalog:",
        "react-router-dom": "catalog:",
