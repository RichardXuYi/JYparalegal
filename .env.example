# GrandPoem Studio Web Environment Variables

# Host server (Fastify + WebSocket) listen port
PORT=8788

# Writable data directory (per-user stores, gateway state; replaces Electron userData)
DATA_DIR=~/.jy-studio-web

# GrandPoem backend base URL (login/refresh/me are proxied through the host server)
BACKEND_URL=http://localhost:8181

# Secret used to sign the session JWT cookie - must be at least 32 characters!
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Set to 1 to skip WS/page auth checks (local development only)
# DISABLE_AUTH=1

# OpenClaw Gateway Configuration
OPENCLAW_GATEWAY_PORT=18789

# Development Configuration
VITE_DEV_SERVER_PORT=5173
